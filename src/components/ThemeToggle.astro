---
import Anchor from './Anchor.astro'
---

<theme-toggle>
  <nav class="Controls">
    <button class="Theme" aria-label="Dark theme">
      <Anchor primary="" />
    </button>
    <button class="Color" aria-label="Monochrome">
      <Anchor primary="" />
    </button>
    <button class="Motion" aria-label="Reduce motion">
      <Anchor primary="" />
    </button>
  </nav>
</theme-toggle>

<script>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super()

      const toggles = [
        {button: this.querySelector('.Theme'), className: 'theme-dark'},
        {button: this.querySelector('.Color'), className: 'color-mono'},
        {button: this.querySelector('.Motion'), className: 'motion-static'},
      ]

      const doc = document.documentElement

      const sync = () => {
        for (const {button, className} of toggles) {
          button?.setAttribute('aria-pressed', String(doc.classList.contains(className)))
        }
      }

      for (const {button, className} of toggles) {
        button?.addEventListener('click', () => {
          doc.classList.toggle(className)
          sync()
        })
      }

      sync()
    }
  }
  customElements.define('theme-toggle', ThemeToggle)
</script>

<style>
  /* The label is drawn from CSS so it matches the classes Head sets before
     first paint, rather than flashing the default until this script runs. */
  .Controls :global(.Anchor__Primary)::after {
    content: var(--toggle-label);
  }

  .Theme {
    --toggle-label: 'Light';
  }

  :global(.theme-dark) .Theme {
    --toggle-label: 'Dark';
  }

  .Color {
    --toggle-label: 'Colour';
  }

  :global(.color-mono) .Color {
    --toggle-label: 'Mono';
  }

  .Motion {
    --toggle-label: 'Motion';
  }

  :global(.motion-static) .Motion {
    --toggle-label: 'Static';
  }

  :global(.color-mono) {
    --color: #000 !important;
    --wordmark-opacity: 0.1;
  }
</style>
