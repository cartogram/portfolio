---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import Head from '../components/Head.astro'
import Anchor from '../components/Anchor.astro'
import Footer from '../components/Footer.astro'
import Wordmark from '../components/Wordmark.astro'
import {ClientRouter} from 'astro:transitions'
import ThemeToggle from '../components/ThemeToggle.astro'

interface Props {
  title?: string | undefined
  description?: string | undefined
  layout?: 'home' | 'single' | 'page'
  color?: string | undefined
}

const {title, description, layout = 'home', color} = Astro.props
---

<html lang="en" style={color ? `--color: ${color}` : ''}>
  <head>
    <Head title={`Matt Seccafien ${title ? `~ ${title}` : ''}`} description={description} />
    <ClientRouter />
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <main class="Main">
      <Wordmark />
      <header class="Wrap Nav">
        <h1 class="Nav__Title">
          <Anchor href="/" primary="Matt Seccafien" />
        </h1>
        <nav class="Nav__Controls">
          <ThemeToggle />
        </nav>
      </header>

      <section class={`Layout Wrap Layout--${layout}`}>
        <div class="Masthead">
          <slot name="masthead" />
        </div>

        {
          layout === 'home' && (
            <div class="Projects">
              <slot name="projects" />
            </div>
          )
        }

        {
          layout === 'single' && (
            <div class="Hero">
              <slot name="hero" />
            </div>
          )
        }

        <div class="Content">
          {
            layout === 'single' && (
              <div class="Chapters">
                <slot name="chapters" />
              </div>
            )
          }

          <div class="ContentBody">
            <slot name="content" />
          </div>
        </div>
      </section>

      {
        layout === 'single' && (
          <div class="Media">
            <slot name="media" />
          </div>
        )
      }
      <Footer />
    </main>

    <script>
      document.addEventListener('astro:page-load', () => {
        document.documentElement.classList.add('loaded')

        // ClientRouter swaps the DOM without restarting autoplaying videos,
        // so kick playback off again after each client-side navigation.
        document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((video) => {
          video.play().catch(() => {})
        })
      })
    </script>
  </body>
</html>

<style>
  .Layout {
    width: 100%;
    /* min-height: 100vh; */
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: auto;
    grid-column-gap: 2rem;
    grid-row-gap: 2rem;
    grid-template-areas:
      'masthead masthead masthead masthead'
      'projects projects projects projects'
      'content content content content';

    z-index: var(--z-index-2);
    position: relative;
    padding-bottom: 2rem;
    flex-grow: 1;
  }

  .Layout--single {
    grid-template-areas:
      'masthead masthead masthead masthead'
      'hero hero hero hero'
      'content content content content';
  }

  .Layout--page {
    grid-auto-rows: auto 1fr;

    grid-template-areas:
      'masthead masthead masthead masthead'
      'content content content content';
  }

  @media (width > 1024px) {
    .Layout {
      grid-template-areas:
        'masthead masthead masthead .'
        'projects projects projects .'
        'content content content content';
    }

    .Layout--single {
      grid-template-areas:
        'masthead masthead . .'
        'hero hero hero hero'
        'content content content content';
    }

    .Layout--page {
      grid-template-areas:
        'masthead masthead . .'
        'content content content content';
    }
  }

  @media (width > 1500px) {
    .Layout {
      grid-template-areas:
        'masthead masthead . .'
        '. . projects projects'
        'content content content content';
    }

    .Layout--single {
      grid-template-areas:
        'masthead masthead . .'
        'hero hero hero hero'
        'content content content content';
    }

    .Layout--page {
      grid-template-areas:
        'masthead masthead . .'
        'content content content content';
    }
  }

  .Layout {
    opacity: 0;
    transform: translateY(1rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .Layout {
      transition: 0.3s ease-in-out;
      transition-delay: 0.3s;
      transition-property: opacity, transform;
    }
  }

  :global(.loaded) .Layout {
    opacity: 1;
    transform: translateY(0);
  }

  .Masthead {
    grid-area: masthead;
  }

  .Hero {
    grid-area: hero;
  }

  .Projects {
    grid-area: projects;
  }

  .Media {
    grid-area: media;
  }

  .Layout--single .Projects {
    position: sticky;
    top: 0;
    align-self: start;
  }

  .Content {
    grid-area: content;
    display: grid;

    p {
      max-width: 53ch;
    }

    .Chapters li {
      font-size: clamp(var(--font-size-sm), 5vw, var(--font-size-md));
    }
  }

  /* single + page share the case-study column grid */
  .Layout--page .Content,
  .Layout--single .Content {
    grid-template-columns: subgrid;
  }

  .Layout--page .ContentBody {
    grid-column: 1 / 5;
  }

  /* single stacks the chapters rail above the body on narrow screens */
  .Layout--single .Chapters {
    grid-column: 1 / 5;
    grid-row: 1;
  }

  .Layout--single .ContentBody {
    grid-column: 1 / 5;
    grid-row: 2;
  }

  @media (width > 1024px) {
    .Layout--single .Chapters {
      grid-column: 4 / 5;
      grid-row: 1;
      position: sticky;
      top: 0;
      align-self: start;
    }

    .Layout--single .ContentBody {
      grid-column: 1 / 4;
      grid-row: 1;
    }
  }

  .Nav {
    padding-bottom: 2rem;
  }
</style>
