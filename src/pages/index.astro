---
import {getCollection} from 'astro:content'
import {Image} from 'astro:assets'

import me1 from '../images/me-1.jpg'
import me3 from '../images/me-3.jpg'

import Layout from '../layouts/Layout.astro'
import Anchor from '../components/Anchor.astro'
import Speaking from '../components/Speaking.astro'

const professionalLinks: {
  label: string
  href: string
}[] = [
  {
    label: 'Say hello',
    href: 'mailto:mseccafien@gmail.com',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/cartogram',
  },
  {
    label: 'View résumé',
    href: '/assets/Matthew Seccafien-CV-2025.pdf',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/mattseccafien/',
  },
]

const projects = (await getCollection('work'))
  .filter((project) => project.data.published)
  .sort((a, b) => b.data.publishDate!.valueOf() - a.data.publishDate!.valueOf())
  .slice(0, 5)

const currentProjects = projects.filter((project) => project.data.tags.includes('Current'))

const pastProjects = projects.filter((project) => project.data.tags.includes('Past'))

// Outlined layers stacked behind the hover preview, echoing the wordmark letters.
// Each hover shows a random number of them between these bounds.
const previewLayers = {min: 2, max: 4}
---

<Layout title="Cartogram">
  <div slot="masthead">
    <h2>
      Berlin-based designer and developer,
      <br />
      builder of user interfaces and systems.
      <br />
    </h2>

    <ul class="List">
      {professionalLinks.map(({label, href}) => (
        <li>
          <Anchor href={href} primary={label} />
        </li>
      ))}
    </ul>
  </div>
  <Fragment slot="projects">
    <ul class="List">
      <li class="">
        <h3>Current</h3>
        <ul class="Projects">
          {currentProjects.map((project) => (
            <li data-preview={project.data.video ? `/assets/${project.id}.mp4` : undefined}>
              <Anchor
                href={project.data.published ? [project.collection, project.id].join('/') : (project.data.url ?? '#')}
                primary={project.data.title}
                secondary={project.data.type}
              />
            </li>
          ))}
        </ul>
      </li>
      <li class="">
        <h3>Past</h3>
        <ul class="Projects">
          {pastProjects.map((project) => (
            <li data-preview={project.data.video ? `/assets/${project.id}.mp4` : undefined}>
              <Anchor
                href={project.data.published ? [project.collection, project.id].join('/') : (project.data.url ?? '#')}
                primary={project.data.title}
                secondary={project.data.type}
              />
            </li>
          ))}
        </ul>
      </li>
    </ul>
    <div
      class="ProjectPreview"
      aria-hidden="true"
      data-min-layers={previewLayers.min}
      style={`--layers: ${previewLayers.max}`}
    >
      {Array.from({length: previewLayers.max}, (_, i) => (
        <div class="ProjectPreview__Layer" style={`--layer: ${previewLayers.max - i}`} />
      ))}
      <div class="ProjectPreview__Layer ProjectPreview__Layer--front" style="--layer: 0">
        <video muted loop playsinline preload="none"></video>
      </div>
    </div>
  </Fragment>
  <div class="ContentLayout" slot="content">
    <div class="ImageContainer">
      <Image class="Image" src={me1} alt="Matthew Seccafien and his black cat Otto standing in his Berlin apartment." />
      <Image class="Image" src={me3} alt="Matthew Seccafien running in the Berlin Marathon 2023." />
      <div>
        <small>
          Follow my inactivity on <a href="https://instagram.com/cartogram">Instagram</a>,{' '}
          <a href="https://www.strava.com/athletes/59501199">Strava</a> or{' '}
          <a href="https://letterboxd.com/cartogram/">Letterboxd</a>.
        </small>
      </div>
    </div>
    <div class="ContentContainer">
      <h3>About me</h3>
      <p>
        In the 20 years since studying in my homeland of <a href="/toronto">Canada</a>, I've held a variety of
        professional roles, starting out in traditional print, typography and information design, to site resiliency
        engineering, to open-source React framework development, and I'm currently interested in design system
        operations.
      </p>
      <p>
        I value creativity and autonomy in both life and work, and thrive when I am invested in the whole idea rather
        than any single facet.
      </p>
      <p>
        When not at my computer I can be found{' '}
        <a target="_blank" rel="noopener noreferrer" href="https://www.strava.com/athletes/59501199">
          running
        </a>{' '}
        around Tempelhofer Feld in <a href="/berlin">Berlin</a>, at the{' '}
        <a href="https://letterboxd.com/cartogram/" target="_blank" rel="noopener noreferrer">
          kino
        </a>{' '}
        or hanging out with my partner{' '}
        <a target="_blank" rel="noopener noreferrer" href="https://www.fimcd.ca/">
          Fiona
        </a>{' '}
        and our cat Otto (pictured).
      </p>

      <Speaking />
    </div>
    <div class="ContentContainer"></div>
  </div>

  <style>
    .ProjectPreview {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 10;
      pointer-events: none;
    }

    /* Layers fade out back-to-front and in front-to-back, like the wordmark stagger. */
    .ProjectPreview__Layer {
      --delay: calc((var(--layers) - var(--layer)) * 30ms);

      position: absolute;
      top: 0;
      left: 0;
      width: 22rem;
      aspect-ratio: 16 / 10;
      border: 1px solid var(--wordmark-color);
      border-radius: var(--radius-2);
      background-color: var(--wordmark-background-color);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 100ms linear var(--delay),
        visibility 0s linear calc(var(--delay) + 100ms);
    }

    .ProjectPreview--visible .ProjectPreview__Layer {
      opacity: 1;
      visibility: visible;
      transition: opacity 100ms linear calc(var(--layer) * 30ms);
    }

    .ProjectPreview__Layer--front {
      overflow: hidden;
      border-color: var(--main-color-faint);
      background-color: var(--main-color-faint);
      box-shadow: var(--shadow-1);
    }

    .ProjectPreview video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @media (prefers-reduced-motion: reduce) {
      .ProjectPreview__Layer:not(.ProjectPreview__Layer--front) {
        display: none;
      }
    }

    :global(.motion-static) .ProjectPreview__Layer:not(.ProjectPreview__Layer--front) {
      display: none;
    }

    .ContentLayout {
      display: grid;
      grid-template-columns: 1fr;
      grid-column-gap: 2rem;
    }

    .ImageContainer {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(4, 1fr);
    }

    @media (width > 950px) {
      .ImageContainer {
        padding-right: 4rem;
      }
      .ContentLayout {
        grid-template-columns: 1fr 1fr;
      }
    }

    .Image {
      position: relative;
      grid-column: 1 / 4;
      grid-row: 1 / 4;
      z-index: 1;
      box-shadow: var(--shadow-1);
    }

    .Image:nth-child(2) {
      grid-column: 3 / 5;
      grid-row: 3 / 5;
      z-index: 0;
    }

    .ImageContainer div {
      grid-column: 1 / 3;
      grid-row: 4 / 5;
    }

    .ImageContainer small {
      display: block;
      text-wrap: balance;
    }
  </style>
</Layout>

<script>
  // Video preview that trails the cursor over projects with a case-study video,
  // modelled on GreenSock's "show cursor image on hover" pen. Outlined layers
  // stack behind it like the wordmark letters, each trailing a little further
  // behind the cursor. Videos are only fetched on first hover.
  function initProjectPreview() {
    const preview = document.querySelector<HTMLElement>('.ProjectPreview')
    const video = preview?.querySelector('video')

    if (!preview || !video || !matchMedia('(hover: hover) and (pointer: fine)').matches) return

    // .Layout carries a transform, which would make position: fixed relative to
    // it rather than the viewport.
    document.body.append(preview)

    // Read on each frame so the Static toggle takes effect without a reload.
    const reducedMotion = () => document.documentElement.classList.contains('motion-static')
    // Front-most layer first.
    const layers = [...preview.querySelectorAll<HTMLElement>('.ProjectPreview__Layer')].reverse().map((el, index) => ({
      el,
      // Time constant for the easing; the front settles in roughly the pen's 0.4s
      // and each layer behind lags a little more.
      smoothing: 0.1 + index * 0.04,
      // Resting step between layers, like the wordmark's stacked letters.
      offset: {x: index * 4, y: index * 4},
      x: 0,
      y: 0,
    }))
    const front = layers[0].el
    // Distance between the cursor and the preview, and between the preview and the viewport edges.
    const gap = 96
    const margin = 32
    const target = {x: 0, y: 0}
    let spread = false
    // Outlined layers shown behind the front one; re-rolled each time the preview appears.
    const minLayers = Number(preview.dataset.minLayers)
    let count = layers.length - 1
    let frame = 0
    let lastTime = 0

    // Sit to the right of the cursor, vertically centred on it. Flip to the left
    // when there isn't room, and keep the whole stack inside the viewport.
    const aim = (event: PointerEvent) => {
      const width = front.offsetWidth
      const height = front.offsetHeight
      const stack = layers[count].offset
      const right = event.clientX + gap
      target.x = right + width + stack.x + margin > window.innerWidth ? event.clientX - gap - width - stack.x : right
      target.y = Math.min(Math.max(event.clientY - height / 2, margin), window.innerHeight - height - stack.y - margin)
    }

    const render = () => {
      layers.forEach((layer) => {
        layer.el.style.translate = `${layer.x}px ${layer.y}px`
      })
    }

    const tick = (time: number) => {
      const dt = lastTime ? (time - lastTime) / 1000 : 0
      lastTime = time
      let moving = false

      layers.forEach((layer) => {
        const t = reducedMotion() ? 1 : 1 - Math.exp(-dt / layer.smoothing)
        const x = target.x + (spread ? layer.offset.x : 0)
        const y = target.y + (spread ? layer.offset.y : 0)
        layer.x += (x - layer.x) * t
        layer.y += (y - layer.y) * t
        if (Math.abs(x - layer.x) > 0.1 || Math.abs(y - layer.y) > 0.1) moving = true
      })
      render()

      frame = moving ? requestAnimationFrame(tick) : 0
    }

    const animate = () => {
      if (!frame) {
        lastTime = 0
        frame = requestAnimationFrame(tick)
      }
    }

    const follow = (event: PointerEvent) => {
      aim(event)
      animate()
    }

    document.querySelectorAll<HTMLElement>('[data-preview]').forEach((item) => {
      item.addEventListener('pointerenter', (event) => {
        const src = item.dataset.preview!
        if (video.getAttribute('src') !== src) video.src = src
        video.play().catch(() => {})

        // Appear collapsed at the cursor, then let the layers fan out behind.
        if (!preview.classList.contains('ProjectPreview--visible')) {
          count = minLayers + Math.floor(Math.random() * (layers.length - minLayers))
          layers.forEach((layer, index) => {
            layer.el.hidden = index > count
          })
          // Keeps the CSS exit stagger running back-to-front from the last visible layer.
          preview.style.setProperty('--layers', String(count))
          aim(event)
          layers.forEach((layer) => {
            layer.x = target.x
            layer.y = target.y
          })
          render()
        }
        spread = true
        preview.classList.add('ProjectPreview--visible')
        animate()
      })
      item.addEventListener('pointermove', follow)
      item.addEventListener('pointerleave', () => {
        spread = false
        preview.classList.remove('ProjectPreview--visible')
        video.pause()
        animate()
      })
    })
  }

  document.addEventListener('astro:page-load', initProjectPreview)
</script>
