---
import {getCollection} from 'astro:content'
import {Image} from 'astro:assets'

import me1 from '../images/me-1.jpg'
import me3 from '../images/me-3.jpg'

import Layout from '../layouts/Layout.astro'
import Anchor from '../components/Anchor.astro'
import Speaking from '../components/Speaking.astro'

const professionalLinks: {
  label: string
  href: string
}[] = [
  {
    label: 'Say hello',
    href: 'mailto:mseccafien@gmail.com',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/cartogram',
  },
  {
    label: 'View résumé',
    href: '/assets/Matthew Seccafien-CV-2025.pdf',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/mattseccafien/',
  },
]

const projects = (await getCollection('work'))
  .filter((project) => project.data.published)
  .sort((a, b) => b.data.publishDate!.valueOf() - a.data.publishDate!.valueOf())
  .slice(0, 5)

const currentProjects = projects.filter((project) => project.data.tags.includes('Current'))

const pastProjects = projects.filter((project) => project.data.tags.includes('Past'))
---

<Layout title="Cartogram">
  <div slot="masthead">
    <h2>
      Berlin-based designer and developer,<br />
      builder of user interfaces and systems.<br />
    </h2>

    <ul class="List">
      {
        professionalLinks.map(({label, href}) => (
          <li>
            <Anchor href={href} primary={label} />
          </li>
        ))
      }
    </ul>
  </div>
  <Fragment slot="projects">
    <ul class="List">
      <li class="">
        <h3>Current</h3>
        <ul class="Projects">
          {
            currentProjects.map((project) => (
              <li data-preview={project.data.video ? `/assets/${project.id}.mp4` : undefined}>
                <Anchor
                  href={project.data.published ? [project.collection, project.id].join('/') : (project.data.url ?? '#')}
                  primary={project.data.title}
                  secondary={project.data.type}
                />
              </li>
            ))
          }
        </ul>
      </li>
      <li class="">
        <h3>Past</h3>
        <ul class="Projects">
          {
            pastProjects.map((project) => (
              <li data-preview={project.data.video ? `/assets/${project.id}.mp4` : undefined}>
                <Anchor
                  href={project.data.published ? [project.collection, project.id].join('/') : (project.data.url ?? '#')}
                  primary={project.data.title}
                  secondary={project.data.type}
                />
              </li>
            ))
          }
        </ul>
      </li>
    </ul>
    <div class="ProjectPreview" aria-hidden="true">
      <video muted loop playsinline preload="none"></video>
    </div>
  </Fragment>
  <div class="ContentLayout" slot="content">
    <div class="ImageContainer">
      <Image class="Image" src={me1} alt="Matthew Seccafien and his black cat Otto standing in his Berlin apartment." />
      <Image class="Image" src={me3} alt="Matthew Seccafien running in the Berlin Marathon 2023." />
      <div>
        <small
          >Follow my inactivity on <a href="https://instagram.com/cartogram">Instagram</a>,<br /><a
            href="https://www.strava.com/athletes/59501199">Strava</a
          > or <a href="https://letterboxd.com/cartogram/">Letterboxd</a>.</small
        >
      </div>
    </div>
    <div class="ContentContainer">
      <h3>About me</h3>
      <p>
        In the 20 years since studying in my homeland of <a href="/toronto">Canada</a>, I've held a variety of
        professional roles, starting out in traditional print, typography and information design, to site resiliency
        engineering, to open-source React framework development, and I'm currently interested in design system
        operations.
      </p>
      <p>
        I value creativity and autonomy in both life and work, and thrive when I am invested in the whole idea rather
        than any single facet.
      </p>
      <p>
        When not at my computer I can be found <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.strava.com/athletes/59501199">running</a
        > around Tempelhofer Feld in <a href="/berlin">Berlin</a>, at the <a
          href="https://letterboxd.com/cartogram/"
          target="_blank"
          rel="noopener noreferrer">kino</a
        > or hanging out with my partner <a target="_blank" rel="noopener noreferrer" href="https://www.fimcd.ca/"
          >Fiona</a
        > and our cat Otto (pictured).
      </p>

      <Speaking />
    </div>
    <div class="ContentContainer"></div>
  </div>

  <style>
    .ProjectPreview {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 10;
      width: 22rem;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: var(--radius-2);
      box-shadow: var(--shadow-1);
      background-color: var(--main-color-light);
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 100ms linear,
        visibility 0s linear 100ms;
    }

    .ProjectPreview--visible {
      opacity: 1;
      visibility: visible;
      transition: opacity 100ms linear;
    }

    .ProjectPreview video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ContentLayout {
      display: grid;
      grid-template-columns: 1fr;
      grid-column-gap: 2rem;
    }

    .ImageContainer {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(4, 1fr);
    }

    @media (width > 950px) {
      .ImageContainer {
        padding-right: 4rem;
      }
      .ContentLayout {
        grid-template-columns: 1fr 1fr;
      }
    }

    .Image {
      position: relative;
      grid-column: 1 / 4;
      grid-row: 1 / 4;
      z-index: 1;
      box-shadow: var(--shadow-1);
    }

    .Image:nth-child(2) {
      grid-column: 3 / 5;
      grid-row: 3 / 5;
      z-index: 0;
    }

    .ImageContainer div {
      grid-column: 1 / 3;
      grid-row: 4 / 5;
    }
  </style>
</Layout>

<script>
  // Video preview that trails the cursor over projects with a case-study video,
  // modelled on GreenSock's "show cursor image on hover" pen. Videos are only
  // fetched on first hover.
  function initProjectPreview() {
    const preview = document.querySelector<HTMLElement>('.ProjectPreview')
    const video = preview?.querySelector('video')

    if (!preview || !video || !matchMedia('(hover: hover) and (pointer: fine)').matches) return

    // .Layout carries a transform, which would make position: fixed relative to
    // it rather than the viewport.
    document.body.append(preview)

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
    // Time constant for the easing; ~0.1s settles in roughly the pen's 0.4s.
    const smoothing = 0.1
    // Gap between the cursor and the preview's left edge, and from the viewport edges.
    const offset = 32
    const current = {x: 0, y: 0}
    const target = {x: 0, y: 0}
    let frame = 0
    let lastTime = 0

    // Sit to the right of the cursor, vertically centred on it. Flip to the left
    // when there isn't room, and keep it inside the viewport vertically.
    const aim = (event: PointerEvent) => {
      const width = preview.offsetWidth
      const height = preview.offsetHeight
      const right = event.clientX + offset
      target.x = right + width + offset > window.innerWidth ? event.clientX - offset - width : right
      target.y = Math.min(Math.max(event.clientY - height / 2, offset), window.innerHeight - height - offset)
    }

    const render = () => {
      preview.style.translate = `${current.x}px ${current.y}px`
    }

    const tick = (time: number) => {
      const dt = lastTime ? (time - lastTime) / 1000 : 0
      lastTime = time
      const t = reducedMotion ? 1 : 1 - Math.exp(-dt / smoothing)
      current.x += (target.x - current.x) * t
      current.y += (target.y - current.y) * t
      render()

      if (Math.abs(target.x - current.x) > 0.1 || Math.abs(target.y - current.y) > 0.1) {
        frame = requestAnimationFrame(tick)
      } else {
        frame = 0
      }
    }

    const follow = (event: PointerEvent) => {
      aim(event)
      if (!frame) {
        lastTime = 0
        frame = requestAnimationFrame(tick)
      }
    }

    document.querySelectorAll<HTMLElement>('[data-preview]').forEach((item) => {
      item.addEventListener('pointerenter', (event) => {
        const src = item.dataset.preview!
        if (video.getAttribute('src') !== src) video.src = src
        video.play().catch(() => {})

        // Snap to the cursor when appearing rather than easing in from the last spot.
        if (!preview.classList.contains('ProjectPreview--visible')) {
          aim(event)
          current.x = target.x
          current.y = target.y
          render()
        }
        preview.classList.add('ProjectPreview--visible')
      })
      item.addEventListener('pointermove', follow)
      item.addEventListener('pointerleave', () => {
        preview.classList.remove('ProjectPreview--visible')
        video.pause()
      })
    })
  }

  document.addEventListener('astro:page-load', initProjectPreview)
</script>
